{
  "name": "web-recorder",
  "version": "0.0.1",
  "private": true,
  "description": "AI-driven web page recording service. URL + natural language → video.",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "regression": "vitest run --config vitest.regression.config.ts",
    "smoke:recording": "bun scripts/smoke-recording.ts",
    "prototype:stagehand": "bun scripts/prototype-stagehand.ts",
    "judge": "bun scripts/judge-recording.ts",
    "eval": "bun scripts/self-eval.ts",
    "serve": "bun scripts/serve.ts",
    "playwright:install": "playwright install chromium",
    "cloakbrowser:install": "cloakbrowser install"
  },
  "dependencies": {
    "@browserbasehq/stagehand": "^3.0.0",
    "cloakbrowser": "^0.3.28",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "playwright": "^1.49.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
