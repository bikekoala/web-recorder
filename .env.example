# OpenRouter (OpenAI-API-compatible aggregator). Required.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Three independent model knobs (since §0023):
# - LLM_MODEL: agent / Stagehand internal observe+act. Use a JSON-mode-
#   reliable model — empirically gpt-4o-mini.
# - LLM_PLANNER_MODEL: planner brief() vision call (once per job). Use a
#   strong vision model — Sonnet 4.6 or Gemini 3.1 Pro both work after
#   §0023's prompt safety rules. Defaults to LLM_MODEL.
# - LLM_DECIDER_MODEL: per-action streaming. Sub-second p95 matters more
#   than capability — gpt-4o-mini is the empirical winner.
# LLM_MODEL=openai/gpt-4o-mini
# LLM_PLANNER_MODEL=anthropic/claude-sonnet-4.6
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Logging: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Default output directory for recordings and traces
OUTPUT_DIR=output

# Optional: which Chromium build to launch. Leave unset to use the bundled
# Chromium installed by `npx playwright install chromium`. Set to `chrome`
# to use the system Google Chrome (handy when the bundled download fails).
# Valid: chromium | chrome | chrome-beta | msedge | msedge-beta | msedge-dev
BROWSER_CHANNEL=

# Director (NEW) ----------------------------------------------------------
# Model used for per-action streaming decisions. Optimized for low latency.
# Recommended: google/gemini-3.1-flash-lite (fast, cheap, strong vision).
# LLM_DECIDER_MODEL=google/gemini-3.1-flash-lite

# Director tunables (defaults are usually fine)
# DIRECTOR_LOOKAHEAD_MAX=2
# DIRECTOR_DWELL_FALLBACK_MS=200
# DIRECTOR_HARD_BUDGET_MULT=1.2
# DIRECTOR_CLICK_REJECTION_LIMIT=2          # §0028 retry cap
# OPENING_HOLD_MIN_MS=200                   # §0029 opening hold
# OPENING_HOLD_MAX_MS=500

# Recording-judge (§0030) — used by `npm run judge`. Needs native video
# input. Default `google/gemini-3.1-pro-preview`. Cheap alternative:
# google/gemini-3.1-flash-lite (preview).
# LLM_JUDGE_MODEL=google/gemini-3.1-pro-preview

# Naturalness rendering bundle (§0031) — defaults are sensible.
# TYPING_PRE_MIN_MS=200          # pause after focus, before first keystroke
# TYPING_PRE_MAX_MS=400
# TYPING_KEYSTROKE_MIN_MS=60     # per-call inter-keystroke delay
# TYPING_KEYSTROKE_MAX_MS=140
# SCROLL_TAIL_MIN_MS=120         # micro-pause appended after every scroll
# SCROLL_TAIL_MAX_MS=280

